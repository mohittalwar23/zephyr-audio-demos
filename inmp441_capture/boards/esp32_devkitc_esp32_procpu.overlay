#include <zephyr/dt-bindings/pinctrl/esp32-pinctrl.h>

/*
 * INMP441 I2S microphone — ESP32 DevKitC (procpu)
 *
 * Wiring:
 *   INMP441 SCK (BCK) -> GPIO2
 *   INMP441 WS  (LRC) -> GPIO15
 *   INMP441 SD  (DAT) -> GPIO13
 *   INMP441 L/R       -> GND  (left channel)
 */

/ {
    aliases {
        i2s-rx = &i2s0;
    };

    chosen {
        /* Move console away from uart0 so uart0 is free for raw PCM */
        zephyr,console    = &uart1;
        zephyr,shell-uart = &uart1;
    };
};

/* uart0 — raw PCM binary output to host */
&uart0 {
    status = "okay";
    current-speed = <921600>;
};

/* uart1 — debug console (optional, for LOG/printk) */
&uart1 {
    status = "okay";
    current-speed = <115200>;
};

/* Override the pinctrl group defined in the board's -pinctrl.dtsi */
&i2s0_default {
    group1 {
        pinmux = <I2S0_I_BCK_GPIO2>,
                 <I2S0_I_WS_GPIO15>,
                 <I2S0_I_SD_GPIO13>;
    };
};

&i2s0 {
    status = "okay";
    interrupts = <I2S0_INTR_SOURCE IRQ_DEFAULT_PRIORITY 0>;
    interrupt-names = "rx";
};